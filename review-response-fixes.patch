index ce5f958..219c3dc 100644
--- a/src/app/api/admin/students/[studentId]/lessons/[lessonId]/override/route.ts
+++ b/src/app/api/admin/students/[studentId]/lessons/[lessonId]/override/route.ts
@@ -18,6 +18,25 @@ export async function POST(
   if ('response' in guard) return guard.response;
 
   const { studentId, lessonId } = await params;
+
+  const lesson = await prisma.lesson.findUnique({
+    where: { id: lessonId },
+    include: { module: true },
+  });
+  if (!lesson) {
+    return NextResponse.json({ error: 'Lesson not found' }, { status: 404 });
+  }
+
+  // An override only makes sense for a student who actually has some
+  // relationship to this course — otherwise this silently creates orphan
+  // LessonProgress rows for a student who was never enrolled.
+  const enrollment = await prisma.enrollment.findFirst({
+    where: { studentUserId: studentId, courseId: lesson.module.courseId },
+  });
+  if (!enrollment) {
+    return NextResponse.json({ error: 'Student is not enrolled in this course' }, { status: 404 });
+  }
+
   const body = await req.json();
   const data = bodySchema.parse(body);
 
