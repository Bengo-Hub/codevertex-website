+'use client';
+
+import { AnimatePresence, motion } from 'framer-motion';
+import { AlertTriangle } from 'lucide-react';
+import { Button } from './button';
+
+interface ConfirmDialogProps {
+  open: boolean;
+  title: string;
+  description?: string;
+  confirmLabel?: string;
+  cancelLabel?: string;
+  destructive?: boolean;
+  onConfirm: () => void;
+  onCancel: () => void;
+}
+
+/**
+ * Shared confirm dialog for destructive actions (delete, revoke, etc).
+ * Use instead of the native window.confirm(), which can't be styled and is
+ * inconsistent with the rest of the product's design language.
+ */
+export function ConfirmDialog({
+  open,
+  title,
+  description,
+  confirmLabel = 'Confirm',
+  cancelLabel = 'Cancel',
+  destructive = true,
+  onConfirm,
+  onCancel,
+}: ConfirmDialogProps) {
+  return (
+    <AnimatePresence>
+      {open && (
+        <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
+          <motion.div
+            initial={{ opacity: 0, scale: 0.96, y: 8 }}
+            animate={{ opacity: 1, scale: 1, y: 0 }}
+            exit={{ opacity: 0, scale: 0.96, y: 8 }}
+            transition={{ duration: 0.15 }}
+            className="w-full max-w-sm rounded-2xl border border-border bg-card p-5 shadow-2xl"
+            role="alertdialog"
+            aria-modal="true"
+            aria-labelledby="confirm-dialog-title"
+          >
+            <div className="flex items-start gap-3">
+              <span
+                className={`flex h-9 w-9 shrink-0 items-center justify-center rounded-xl ${
+                  destructive ? 'bg-destructive/10 text-destructive' : 'bg-primary/10 text-primary'
+                }`}
+              >
+                <AlertTriangle className="h-4.5 w-4.5" />
+              </span>
+              <div className="min-w-0">
+                <h2 id="confirm-dialog-title" className="text-sm font-bold text-foreground">{title}</h2>
+                {description && <p className="text-sm text-muted-foreground mt-1 leading-relaxed">{description}</p>}
+              </div>
+            </div>
+            <div className="flex items-center justify-end gap-2 mt-5">
+              <Button variant="ghost" size="sm" onClick={onCancel}>{cancelLabel}</Button>
+              <Button
+                size="sm"
+                variant={destructive ? 'destructive' : 'default'}
+                onClick={onConfirm}
+              >
+                {confirmLabel}
+              </Button>
+            </div>
+          </motion.div>
+        </div>
+      )}
+    </AnimatePresence>
+  );
+}
