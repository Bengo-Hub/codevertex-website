// Codevertex Website — Prisma Schema
// Prisma 7 — connection URL is in prisma.config.ts, not here

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id        BigInt   @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  source    String   @default("website")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("contact_submissions")
}

model Lead {
  id            BigInt   @id @default(autoincrement())
  name          String?
  email         String?
  phone         String?
  topic         String?
  preferredTime String?  @map("preferred_time")
  source        String   @default("chatbot")
  notes         String?
  status        String   @default("new")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("leads")
}

model StudentUser {
  id        String   @id  // DGT-XXXXXXXX unique student ID
  email     String   @unique
  fullName  String   @map("full_name")
  phone     String
  dob       DateTime? @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  enrollments Enrollment[]
  progress    LessonProgress[]
  quizAttempts QuizAttempt[]
  certificates Certificate[]

  @@index([email])
  @@map("student_users")
}

// ---------------------------------------------------------------------------
// Discount rules — admin-configurable promo discounts for course enrollments
// ---------------------------------------------------------------------------
model DiscountRule {
  id            BigInt    @id @default(autoincrement())
  name          String                        // e.g. "Early Bird — May 2026"
  code          String    @unique             // e.g. "EARLY5" or "FIRST10"
  description   String?
  discountPct   Int?      @map("discount_pct")    // percentage (1-100), mutually exclusive with discountAmount
  discountAmount Int?     @map("discount_amount")  // fixed KES amount off
  courseId      String?   @map("course_id")   // null = applies to all courses
  maxUses       Int?      @map("max_uses")    // null = unlimited
  usedCount     Int       @default(0) @map("used_count")
  validFrom     DateTime? @map("valid_from")
  validUntil    DateTime? @map("valid_until")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  enrollments   Enrollment[]

  @@index([code])
  @@index([active])
  @@map("discount_rules")
}

model Enrollment {
  id              BigInt    @id @default(autoincrement())
  courseId        String    @map("course_id")
  courseName      String    @map("course_name")
  category        String
  fullName        String    @map("full_name")
  email           String
  phone           String
  dob             DateTime? @db.Date
  experience      String?
  howHeard        String?   @map("how_heard")
  amount          Int                        // first payment amount (installment 1 or full)
  totalAmount     Int?      @map("total_amount")  // full course price
  currency        String    @default("KES")
  paymentRef      String?   @map("payment_ref")
  paymentStatus   String    @default("pending") @map("payment_status")
  paymentPlan     String?   @map("payment_plan")  // 'upfront' | '2-installments' | '3-installments'
  installmentNo   Int?      @map("installment_no")
  cohortId        BigInt?   @map("cohort_id")
  studentUserId   String?   @map("student_user_id")
  notifiedAt      DateTime? @map("notified_at")
  // Discount fields — set at enrollment time from applicable DiscountRule
  discountRuleId  BigInt?   @map("discount_rule_id")
  discountCode    String?   @map("discount_code")
  discountPct     Int?      @map("discount_pct")    // percentage applied (0-100)
  discountAmount  Int?      @map("discount_amount")  // absolute KES discount applied
  createdAt       DateTime  @default(now()) @map("created_at")

  cohort        Cohort?       @relation(fields: [cohortId], references: [id])
  studentUser   StudentUser?  @relation(fields: [studentUserId], references: [id])
  discountRule  DiscountRule? @relation(fields: [discountRuleId], references: [id])
  installments  InstallmentSchedule[]

  @@index([email])
  @@index([paymentStatus])
  @@index([studentUserId])
  @@index([discountRuleId])
  @@map("enrollments")
}

model InstallmentSchedule {
  id            BigInt    @id @default(autoincrement())
  enrollmentId  BigInt    @map("enrollment_id")
  installmentNo Int       @map("installment_no")  // 1, 2, 3
  amount        Int
  currency      String    @default("KES")
  dueDate       DateTime  @map("due_date") @db.Date
  paidAt        DateTime? @map("paid_at")
  paymentRef    String?   @map("payment_ref")
  status        String    @default("pending")  // pending | paid | overdue | reminded
  reminderSentAt DateTime? @map("reminder_sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@index([enrollmentId])
  @@index([dueDate])
  @@index([status])
  @@map("installment_schedules")
}

model Cohort {
  id                BigInt       @id @default(autoincrement())
  courseId          String       @map("course_id")
  name              String
  startDate         DateTime     @map("start_date") @db.Date
  endDate           DateTime?    @map("end_date") @db.Date
  registrationFrom       DateTime?    @map("registration_from")        // when enrollment/registration opens
  registrationUntil      DateTime?    @map("registration_until")       // registration deadline (discount valid-until auto-filled from this)
  registrationExtDays    Int          @default(0) @map("registration_ext_days")  // admin-granted extension in days added on top of registrationUntil
  maxSlots          Int          @default(20) @map("max_slots")
  status            String       @default("open")
  createdAt         DateTime     @default(now()) @map("created_at")

  enrollments Enrollment[]

  @@map("cohorts")
}

// ---------------------------------------------------------------------------
// Courses — DB-driven course catalog (mirrors courses.ts config)
// ---------------------------------------------------------------------------
model Course {
  id              String   @id
  categoryId      String   @map("category_id")
  name            String
  shortName       String?  @map("short_name")
  slug            String   @unique
  duration        String
  mode            String
  price           Int
  currency        String   @default("KES")
  description     String
  longDescription String?  @map("long_description") @db.Text
  level           String   @default("beginner")
  audience        String?
  stack           String?
  coverImage      String?  @map("cover_image")
  outcomes        String[]
  prerequisites   String[] @default([])
  careerPaths     String[] @default([]) @map("career_paths")
  includes        String[] @default([])
  featured            Boolean  @default(false)
  isActive            Boolean  @default(true) @map("is_active")
  installmentsEnabled Boolean  @default(true) @map("installments_enabled")
  installmentPlans    Json?    @default("[]") @map("installment_plans")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  modules      CourseModule[]
  certificates Certificate[]

  @@index([featured])
  @@index([isActive])
  @@map("courses")
}

// ---------------------------------------------------------------------------
// Digitika Academy — course content delivery (modules, lessons, progress,
// quizzes, certificates). Added to close the "checkout-only, no LMS" gap.
// No third-party integration: video is a plain URL field for now (self-hosted
// or an external link) until a streaming provider is chosen; everything else
// (progress, quizzes, certs) is pure DB + server-rendered PDF.
// ---------------------------------------------------------------------------

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  RESOURCE
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id           String     @id @default(cuid())
  moduleId     String     @map("module_id")
  title        String
  type         LessonType @default(TEXT)
  // TEXT: rendered markdown body. VIDEO: video source (self-hosted path or external URL,
  // e.g. YouTube unlisted) — no streaming-provider integration decided yet, see docs/integrations.md.
  content      String?    @db.Text
  videoUrl     String?    @map("video_url")
  durationSec  Int?       @map("duration_sec")
  // Downloadable resource (RESOURCE type) — path under /public or an external file URL.
  resourceUrl  String?    @map("resource_url")
  resourceName String?    @map("resource_name")
  // Free-preview lessons are visible to anyone, even without a paid enrollment.
  isPreview    Boolean    @default(false) @map("is_preview")
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz     Quiz?
  progress LessonProgress[]

  @@index([moduleId])
  @@map("lessons")
}

model LessonProgress {
  id                  String    @id @default(cuid())
  lessonId            String    @map("lesson_id")
  studentUserId       String    @map("student_user_id")
  completedAt         DateTime? @map("completed_at")
  lastPositionSec     Int?      @map("last_position_sec")   // video resume point
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentUser StudentUser @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentUserId])
  @@index([studentUserId])
  @@map("lesson_progress")
}

model Quiz {
  id            String   @id @default(cuid())
  lessonId      String   @unique @map("lesson_id")
  title         String
  passingScore  Int      @default(70) @map("passing_score") // percent
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id           String   @id @default(cuid())
  quizId       String   @map("quiz_id")
  prompt       String   @db.Text
  options      Json     // string[] — answer choices
  correctIndex Int      @map("correct_index")
  sortOrder    Int      @default(0) @map("sort_order")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id            String   @id @default(cuid())
  quizId        String   @map("quiz_id")
  studentUserId String   @map("student_user_id")
  scorePct      Int      @map("score_pct")
  passed        Boolean
  answers       Json     // number[] — chosen option index per question, in question order
  createdAt     DateTime @default(now()) @map("created_at")

  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentUser StudentUser @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([studentUserId])
  @@map("quiz_attempts")
}

model Certificate {
  id                String   @id @default(cuid())
  certificateNumber String   @unique @map("certificate_number") // e.g. CV-DGT-2026-000123, shown on the PDF
  verifyToken       String   @unique @default(cuid()) @map("verify_token") // opaque, used in the public verify URL instead of the sequential number
  studentUserId     String   @map("student_user_id")
  courseId          String   @map("course_id")
  enrollmentId      BigInt?  @map("enrollment_id")
  studentName       String   @map("student_name")   // snapshot at issue time — survives student profile edits
  courseName        String   @map("course_name")    // snapshot at issue time — survives course catalog edits
  issuedAt          DateTime @default(now()) @map("issued_at")
  revoked           Boolean  @default(false)

  studentUser StudentUser @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
  @@index([courseId])
  @@map("certificates")
}

// ---------------------------------------------------------------------------
// Blog posts — CMS for the /blog section
// ---------------------------------------------------------------------------
model BlogPost {
  id          BigInt    @id @default(autoincrement())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String    @db.Text
  author      String
  coverImage  String?   @map("cover_image")
  tags        String[]  @default([])
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([published])
  @@index([publishedAt(sort: Desc)])
  @@index([slug])
  @@map("blog_posts")
}

// ---------------------------------------------------------------------------
// Site users — SSO-synced users who log in via accounts.codevertexafrica.com
// ---------------------------------------------------------------------------
model SiteUser {
  id          String    @id
  email       String    @unique
  fullName    String?   @map("full_name")
  avatarUrl   String?   @map("avatar_url")
  role        String    @default("member")  // legacy label mirrored from the last SSO sync payload ('member' | 'admin')
  tenantId    String?   @map("tenant_id")
  tenantSlug  String?   @map("tenant_slug")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Digitika admin-panel RBAC (Trinity Layer 3 — local to this service, independent of `role` above).
  // Null = no panel access unless the user's SSO global role passes the platform-admin bypass.
  digitikaRoleCode String? @map("digitika_role_code")
  digitikaRole     DigitikaRole? @relation(fields: [digitikaRoleCode], references: [code])
  syncedFromSso    Boolean       @default(false) @map("synced_from_sso") // true = pulled in via admin "Sync platform users", not a real login yet

  @@index([email])
  @@index([tenantId])
  @@index([role])
  @@index([digitikaRoleCode])
  @@map("site_users")
}

// ---------------------------------------------------------------------------
// Digitika admin-panel RBAC — Trinity Layer 3 (local role/permission catalog).
// Permission codes follow the platform-wide `{service}.{module}.{action}` format,
// e.g. `digitika.students.manage`. See shared-docs/architecture/trinity-authorization-pattern.md.
// ---------------------------------------------------------------------------
model DigitikaPermission {
  id          String   @id @default(cuid())
  code        String   @unique  // e.g. "digitika.students.manage"
  module      String             // e.g. "students"
  action      String             // "view" | "manage"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles DigitikaRolePermission[]

  @@index([module])
  @@map("digitika_permissions")
}

model DigitikaRole {
  id          String   @id @default(cuid())
  code        String   @unique  // e.g. "digitika_admin"
  name        String             // e.g. "Digitika Admin"
  description String?
  isSystem    Boolean  @default(false) @map("is_system")  // seeded roles — permissions locked for digitika_admin
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions DigitikaRolePermission[]
  users       SiteUser[]

  @@map("digitika_roles")
}

model DigitikaRolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       DigitikaRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission DigitikaPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("digitika_role_permissions")
}
