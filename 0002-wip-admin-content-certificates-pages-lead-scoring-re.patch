+            Cancel
+          </button>
+          <button
+            onClick={handleSave}
+            disabled={saving}
+            className="px-4 py-2 text-sm rounded-lg bg-primary text-primary-foreground font-semibold hover:opacity-90 disabled:opacity-50"
+          >
+            {saving ? 'Saving…' : 'Save quiz'}
+          </button>
+        </div>
+      </div>
