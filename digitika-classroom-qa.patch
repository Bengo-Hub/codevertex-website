+// ---------------------------------------------------------------------------
+// Course announcements — admin-posted updates for a course's enrolled students.
+// Managed from the admin dashboard (Classroom page), not a separate instructor
+// portal — see docs note in ClassroomPage.tsx.
+// ---------------------------------------------------------------------------
+model CourseAnnouncement {
+  id        String   @id @default(cuid())
+  courseId  String   @map("course_id")
+  title     String
+  body      String   @db.Text
+  createdAt DateTime @default(now()) @map("created_at")
+  updatedAt DateTime @updatedAt @map("updated_at")
+
+  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
+
+  @@index([courseId])
+  @@index([createdAt(sort: Desc)])
+  @@map("course_announcements")
+}
+
+// ---------------------------------------------------------------------------
+// Course Q&A / discussion — one thread per student question, replies from
+// either the asking student, other students, or an admin (isAdminReply).
+// Admins moderate/answer from the admin dashboard Classroom page.
+// ---------------------------------------------------------------------------
+model CourseThread {
+  id            String   @id @default(cuid())
+  courseId      String   @map("course_id")
+  studentUserId String   @map("student_user_id")
+  title         String
+  body          String   @db.Text
+  pinned        Boolean  @default(false)
+  createdAt     DateTime @default(now()) @map("created_at")
+
+  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
+  studentUser StudentUser   @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
+  replies     CourseReply[]
+
+  @@index([courseId])
+  @@index([studentUserId])
+  @@index([pinned])
+  @@map("course_threads")
+}
+
+model CourseReply {
+  id            String   @id @default(cuid())
+  threadId      String   @map("thread_id")
+  studentUserId String?  @map("student_user_id")  // null when isAdminReply is true
+  isAdminReply  Boolean  @default(false) @map("is_admin_reply")
+  adminName     String?  @map("admin_name")        // snapshot of the replying admin's display name
+  body          String   @db.Text
+  createdAt     DateTime @default(now()) @map("created_at")
+
+  thread      CourseThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
+  studentUser StudentUser? @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
+
+  @@index([threadId])
+  @@map("course_replies")
+}
+
 // ---------------------------------------------------------------------------
 // Discount rules — admin-configurable promo discounts for course enrollments
 // ---------------------------------------------------------------------------
@@ -206,8 +268,10 @@ model Course {
   updatedAt           DateTime @updatedAt @map("updated_at")
 
   @@index([categoryId])
-  modules      CourseModule[]
-  certificates Certificate[]
+  modules       CourseModule[]
+  certificates  Certificate[]
+  announcements CourseAnnouncement[]
+  threads       CourseThread[]
 
   @@index([featured])
   @@index([isActive])
@@ -258,6 +322,10 @@ model Lesson {
   // Downloadable resource (RESOURCE type) — path under /public or an external file URL.
   resourceUrl  String?    @map("resource_url")
