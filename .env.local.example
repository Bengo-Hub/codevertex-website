# Copy this file to .env.local and fill in real values.
# In production these are injected by K8s secrets — see .github/workflows/deploy.yml
# and prisma.config.ts. Nothing here should be committed with real values.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/codevertex_website"

# --- Site / app -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth / SSO (auth-api) ---------------------------------------------------
NEXT_PUBLIC_AUTH_SERVICE_URL="https://sso.codevertexafrica.com"
NEXT_PUBLIC_SSO_URL="https://sso.codevertexafrica.com"
NEXT_PUBLIC_SSO_CLIENT_ID="codevertex-website"

# --- Platform-tenant scoping --------------------------------------------------
NEXT_PUBLIC_ERP_API_URL="https://erp.codevertexafrica.com"
NEXT_PUBLIC_ERP_TENANT="codevertex"
NEXT_PUBLIC_TREASURY_TENANT="codevertex"

# --- Server-to-server API base URLs ------------------------------------------
SUBSCRIPTIONS_API_URL="https://subscriptions.codevertexafrica.com"
TREASURY_API_URL="https://books.codevertexafrica.com"
NOTIFICATIONS_API_URL="https://notifications.codevertexafrica.com"

# --- Secrets (ask a teammate — never share these in chat/Slack) -------------
INTERNAL_SERVICE_KEY=""
TREASURY_WEBHOOK_SECRET=""

# --- Event bus ----------------------------------------------------------------
EVENTS_NATS_URL="nats://localhost:4222"
