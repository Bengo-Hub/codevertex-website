# Copy this file to .env.local (or .env) and fill in real values.
# Never commit .env or .env.local — both are already in .gitignore.

# --- Core ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (Prisma). Point at your local Postgres, e.g.:
# `psql -c "CREATE DATABASE codevertex;"` then run `psql $DATABASE_URL -f scripts/schema.sql`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codevertex?schema=public"

# Anthropic API key for the Vera chatbot (POST /api/chat, claude-haiku-4-5).
# Get your own key from https://console.anthropic.com/ — do not reuse another dev's key.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- SSO / auth-service ---
# These drive login (see src/lib/auth/sso-api.ts, src/lib/auth/rbac.ts).
# Left unset/commented, the code falls back to PRODUCTION SSO (sso.codevertexafrica.com) —
# real production accounts would be needed to log in, and local seed accounts won't exist there.
# To log in locally instead, run auth-api locally (default HTTP_PORT=4000) and seed it:
#   cd ../auth-service/auth-api && go run ./cmd/seed
# then point this at it:
# NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4000
NEXT_PUBLIC_SSO_CLIENT_ID=codevertex-website
# Only needed if you also run auth-ui locally (it has no fixed default port — pick one,
# e.g. `next dev -p 3001`, and set it here). Otherwise leave unset; it only affects where
# logout redirects to.
# NEXT_PUBLIC_SSO_URL=http://localhost:3001

# Local dev seed accounts created by auth-api's `cmd/seed` (see auth-api/cmd/seed/seed_users.go) —
# only valid when logging into a LOCALLY seeded auth-service, not production:
#   admin@codevertexafrica.com        / ChangeMe123!        (platform superuser)
#   admin@demo.codevertexafrica.com   / DemoAdmin2024!       (demo tenant admin — the fleet's
#                                                             sole demo/e2e login account)
# Override the admin seed via SEED_SUPER_ADMIN_EMAIL / SEED_SUPER_ADMIN_PASSWORD when
# running the seed command — never rely on the ChangeMe123! default outside local dev.

# Shared server-to-server key — must match INTERNAL_SERVICE_KEY configured on auth-api /
# notifications-api. Ask whoever manages local service secrets for the shared dev value;
# generate a fresh one for any real deployment.
INTERNAL_SERVICE_KEY=REPLACE_ME

# --- Treasury (Digitika payments) ---
# Optional — defaults to production (booksapi.codevertexafrica.com) if unset.
# treasury-api's own local default port is 4010.
# TREASURY_API_URL=http://localhost:4010
NEXT_PUBLIC_TREASURY_TENANT=codevertex
# Must match the signing secret configured on treasury-api's webhook sender. Optional for
# local dev — if unset, incoming webhooks are accepted unsigned (see webhooks/treasury/route.ts).
TREASURY_WEBHOOK_SECRET=

# --- ERP ---
# Optional — defaults to production (erpapi.codevertexafrica.com) if unset.
# erp-api's own local default port is 4000 (same default as auth-api — override one if
# running both locally at once).
# NEXT_PUBLIC_ERP_API_URL=http://localhost:4000
NEXT_PUBLIC_ERP_TENANT=codevertex

# --- Subscriptions ---
# Optional — defaults to production (pricingapi.codevertexafrica.com) if unset.
# subscriptions-api's own local default port is 4008.
# SUBSCRIPTIONS_API_URL=http://localhost:4008

# --- Notifications (email/SMS via notifications-api) ---
# Optional — defaults to production (notificationsapi.codevertexafrica.com) if unset.
# notifications-api's own local default port is 4004.
# NOTIFICATIONS_API_URL=http://localhost:4004

# --- Events (NATS JetStream) ---
# Optional — leave empty to skip event publishing and fall back to direct HTTP calls.
EVENTS_NATS_URL=
